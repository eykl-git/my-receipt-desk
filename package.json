{
  "name": "my-receipt-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-only prototype demonstrating the Campaign 21 knowledge loop for receipt-to-card-statement reconciliation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run ocr:assets && vite",
    "build": "npm run ocr:assets && tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "npm run ocr:assets && tsc -b && vite build --mode pages",
    "preview:pages": "vite preview --mode pages --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e:dev": "playwright test",
    "e2e:pages": "playwright test -c playwright.pages.config.ts",
    "e2e": "npm run e2e:dev && npm run e2e:pages",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run e2e",
    "ocr:assets": "node scripts/ocr/copy-assets.mjs",
    "ocr:samples": "node scripts/ocr/make-samples.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/msa": "1.0.0",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "supabase": "^2.121.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
